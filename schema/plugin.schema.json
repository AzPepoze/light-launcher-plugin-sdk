{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-launcher.dev/schema/plugin.schema.json",
  "title": "Light Launcher plugin manifest",
  "description": "The plugin.json file at the root of a .llplugin package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "apiVersion",
    "minHost",
    "entry",
    "contributes",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$",
      "description": "Unique plugin id: lowercase letters, digits and dashes."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "description": "Who wrote the plugin."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What the plugin does, in a sentence or two."
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://\\S+$",
      "description": "Web page for the plugin, such as its repository or docs. An http or https URL."
    },
    "repository": {
      "type": "string",
      "pattern": "^github:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$",
      "description": "GitHub repository for the planned updater, such as github:owner/repo."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
      "description": "Plugin version, semver."
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "Major protocol version the plugin targets."
    },
    "minHost": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Oldest host version that can run this plugin, semver."
    },
    "entry": {
      "type": "object",
      "description": "Executable per platform, relative to the package root.",
      "minProperties": 1,
      "additionalProperties": false,
      "propertyNames": {
        "pattern": "^(linux|windows|mac)-(x64|arm64)$"
      },
      "patternProperties": {
        "^(linux|windows|mac)-(x64|arm64)$": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "contributes": {
      "$ref": "#/$defs/contributes"
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!\\\\)",
      "description": "Path inside the package. No leading slash and no '..' segments."
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "settings": {
          "type": "object",
          "description": "Settings schema. Drives the auto-generated settings form.",
          "additionalProperties": false,
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[A-Za-z][A-Za-z0-9]*)+$",
          "description": "The plugin method the launcher calls to run this command, such as demo.importKey."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "capabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "tile": {
          "enum": [
            "poster",
            "wide",
            "square"
          ],
          "default": "poster",
          "description": "Older card shape: poster (3:4), wide (16:9) or square (1:1). cover wins when both are set."
        },
        "cover": {
          "$ref": "#/$defs/cover"
        },
        "actions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/sourceAction"
          },
          "description": "Buttons the library shows for the source. Ids must be unique inside the source."
        },
        "card": {
          "$ref": "#/$defs/sourceCard"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "browse",
              "browse:filters",
              "auth",
              "updateCheck",
              "resolveFiles",
              "sync:games",
              "sync:index",
              "listGames"
            ]
          },
          "not": {
            "allOf": [
              {
                "contains": {
                  "const": "sync:games"
                }
              },
              {
                "contains": {
                  "const": "sync:index"
                }
              }
            ]
          }
        },
        "sidebar": {
          "type": "array",
          "minItems": 1,
          "description": "Filters shown beside the source's list, in this order. Needs the browse:filters capability.",
          "items": {
            "$ref": "#/$defs/sidebarGroup"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "sidebar"
            ]
          },
          "then": {
            "properties": {
              "capabilities": {
                "type": "array",
                "contains": {
                  "const": "browse:filters"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "array",
                "contains": {
                  "const": "browse:filters"
                }
              }
            }
          },
          "then": {
            "required": [
              "sidebar"
            ]
          }
        }
      ]
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratio"
      ],
      "properties": {
        "ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]?:[1-9][0-9]?$",
          "description": "Width:height of the card box, such as 4:3. Sides are 1 to 32, and width to height is 0.25 to 4 (checked by the launcher)."
        }
      }
    },
    "sourceAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "method"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Material icon name, such as sync."
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[A-Za-z][A-Za-z0-9]*)+$",
          "description": "The plugin method the launcher calls, such as demo-site.sync."
        },
        "scope": {
          "enum": [
            "library",
            "game"
          ],
          "default": "library",
          "description": "library: shown in the library sidebar. game: shown in the game detail."
        }
      }
    },
    "sourceCard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "enum": [
            "sourceId",
            "title",
            "version",
            "developer",
            "engine",
            "status",
            "updatedAt"
          ],
          "default": "title"
        },
        "subtitle": {
          "enum": [
            "sourceId",
            "title",
            "version",
            "developer",
            "engine",
            "status",
            "updatedAt"
          ],
          "default": "version"
        },
        "badges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "favorite",
              "updateAvailable",
              "installed"
            ]
          }
        }
      }
    },
    "sidebarGroup": {
      "description": "One group in a source sidebar. The type decides the control the launcher shows.",
      "oneOf": [
        {
          "$ref": "#/$defs/sidebarSearch"
        },
        {
          "$ref": "#/$defs/sidebarToggles"
        },
        {
          "$ref": "#/$defs/sidebarSelect"
        },
        {
          "$ref": "#/$defs/sidebarMulti"
        },
        {
          "$ref": "#/$defs/sidebarSort"
        }
      ]
    },
    "sidebarSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "const": "search"
        },
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sidebarOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sidebarToggles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "options"
      ],
      "properties": {
        "type": {
          "const": "toggles"
        },
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sidebarSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "label"
      ],
      "oneOf": [
        {
          "required": [
            "options"
          ]
        },
        {
          "required": [
            "dynamic"
          ]
        }
      ],
      "properties": {
        "type": {
          "const": "select"
        },
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sidebarOption"
          }
        },
        "dynamic": {
          "const": true,
          "description": "The options come from source.listFilters."
        }
      }
    },
    "sidebarMulti": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "label",
        "dynamic"
      ],
      "properties": {
        "type": {
          "const": "multi"
        },
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "dynamic": {
          "const": true,
          "description": "The options come from source.listFilters."
        },
        "searchable": {
          "type": "boolean",
          "default": false,
          "description": "Show a box to filter the options."
        }
      }
    },
    "sidebarSort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "options"
      ],
      "properties": {
        "type": {
          "const": "sort"
        },
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sidebarOption"
          }
        },
        "orderable": {
          "type": "boolean",
          "default": false,
          "description": "Show an ascending or descending button."
        },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "order"
          ],
          "description": "The sort the list starts with. Its value must be one of the options.",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "order": {
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        }
      }
    },
    "fsName": {
      "description": "A folder the host grants. The host maps only these names: $GAMES, $DOWNLOADS, $DATA, and $APPDATA_<NAME> for an app's data folder.",
      "anyOf": [
        {
          "enum": [
            "$GAMES",
            "$DOWNLOADS",
            "$DATA"
          ]
        },
        {
          "type": "string",
          "pattern": "^\\$APPDATA_[A-Z][A-Z0-9_]*$"
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[a-z0-9-]+(\\.[a-z0-9-]+)+$",
            "description": "Host name, or *.host to allow subdomains."
          }
        },
        "fs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fsName"
          }
        },
        "secrets": {
          "type": "boolean",
          "default": false
        },
        "browser": {
          "type": "boolean",
          "default": false
        },
        "exec": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}

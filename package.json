{
  "name": "@light-launcher/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./manifest": "./src/schema/manifest.ts",
    "./schema/*": "./schema/*"
  },
  "description": "SDK for writing Light Launcher plugins: protocol types, plugin runtime, helpers and the llp CLI.",
  "bin": {
    "llp": "src/cli/llp.ts"
  },
  "files": [
    "src",
    "schema",
    "templates",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}

{
  "name": "@light-launcher/plugin-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "SDK for writing Light Launcher plugins: protocol types, plugin runtime, helpers and the llp CLI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzPepoze/light-launcher-plugin-sdk.git"
  },
  "homepage": "https://github.com/AzPepoze/light-launcher-plugin-sdk#readme",
  "bugs": {
    "url": "https://github.com/AzPepoze/light-launcher-plugin-sdk/issues"
  },
  "keywords": [
    "light-launcher",
    "plugin",
    "sdk",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./downloads": "./src/downloads/index.ts",
    "./manifest": "./src/schema/manifest.ts",
    "./schema/*": "./schema/*"
  },
  "bin": {
    "llp": "src/cli/llp.ts"
  },
  "files": [
    "src",
    "schema",
    "templates",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun test && bun run typecheck"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
